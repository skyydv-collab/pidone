{
  "name": "pidone-backend",
  "version": "1.0.0",
  "description": "Backend API for Pidone video editing platform",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "dev": "nodemon --exec node --loader tsx src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "db:migrate": "prisma migrate deploy",
    "db:seed": "node --loader tsx prisma/seed.ts",
    "db:studio": "prisma studio"
  },
  "dependencies": {
    "express": "^4.18.2",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "@prisma/client": "^5.7.1",
    "bcrypt": "^5.1.1",
    "jsonwebtoken": "^9.1.2",
    "multer": "^1.4.5-lts.1",
    "fluent-ffmpeg": "^2.1.3",
    "axios": "^1.6.7",
    "socket.io": "^4.7.2",
    "express-validator": "^7.0.0",
    "helmet": "^7.1.0",
    "express-rate-limit": "^7.1.5",
    "cloudinary": "^1.40.0",
    "sharp": "^0.33.0"
  },
  "devDependencies": {
    "typescript": "^5.3.3",
    "@types/express": "^4.17.21",
    "@types/node": "^20.10.6",
    "@types/bcrypt": "^5.0.2",
    "nodemon": "^3.0.2",
    "tsx": "^4.7.0",
    "prisma": "^5.7.1",
    "@types/multer": "^1.4.11"
  }
}
